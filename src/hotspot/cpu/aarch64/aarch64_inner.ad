instruct string_equalsL(
    iRegP      str1_in,      // str1 (kill)
    iRegP      str2_in,      // str2 (kill)
    iRegI      cnt_in,       // int length (kill)
    iRegINoSp  str1_hi,     // temp: str1 high 8B
    iRegINoSp  str2_hi,     // temp: str2 high 8B (reused as shift amount in SMALL)
    iRegINoSp  result,    // boolean
    rFlagsReg  cr)
%{
  predicate(UseSVE == 0 && ((StrEqualsNode*)n)->encoding() == StrIntrinsicNode::LL);
  match(Set result (StrEquals (Binary str1_in str2_in) cnt_in));
  effect(TEMP_DEF result, USE_KILL str1_in, USE_KILL str2_in, USE_KILL cnt_in, TEMP str1_hi, TEMP str2_hi, KILL cr);

  format %{ "String Equals $str1_in,$str2_in,$cnt_in -> $result" %}
  ins_encode %{
    // __ assert_different_registers($str1$$Register, $str2$$Register, $cnt$$Register,
    //                               $result$$Register, $str1_hi$$Register, $str2_hi$$Register);
    // Count is in 8-bit bytes; non-Compact chars are 16 bits.
    // __ mov($str1$$Register, $str1_in$$Register);
    // __ mov($str2$$Register, $str2_in$$Register);
    // __ movw($cnt$$Register,  $cnt_in$$Register);
    __ string_equals($str1_in$$Register, $str2_in$$Register,
                     $result$$Register, $cnt_in$$Register,
                     $str1_hi$$Register, $str2_hi$$Register);
  %}
  ins_pipe(pipe_class_memory);
%}

instruct array_equalsB(iRegPNoSp ary1, iRegPNoSp ary2, iRegINoSp result,
                       iRegPNoSp tmp1, iRegPNoSp tmp2, iRegPNoSp tmp3,
                       vRegD vtmp0, vRegD vtmp1, vRegD vtmp2, vRegD vtmp3,
                       vRegD vtmp4, vRegD vtmp5, vRegD vtmp6, vRegD vtmp7,
                       iRegPNoSp tmp, rFlagsReg cr)
%{
  predicate(((AryEqNode*)n)->encoding() == StrIntrinsicNode::LL);
  match(Set result (AryEq ary1 ary2));
  effect(TEMP_DEF result, TEMP tmp, USE_KILL ary1, USE_KILL ary2, TEMP tmp1, TEMP tmp2, TEMP tmp3,
         TEMP vtmp0, TEMP vtmp1, TEMP vtmp2, TEMP vtmp3, TEMP vtmp4, TEMP vtmp5,
         TEMP vtmp6, TEMP vtmp7, KILL cr);

  format %{ "Array Equals $ary1,ary2 -> $result # KILL $ary1 $ary2 $tmp $tmp1 $tmp2 $tmp3 V0-V7 cr" %}
  ins_encode %{
    address tpc = __ arrays_equals($ary1$$Register, $ary2$$Register,
                                   $tmp1$$Register, $tmp2$$Register, $tmp3$$Register,
                                   $result$$Register, $tmp$$Register, 1);
    if (tpc == nullptr) {
      ciEnv::current()->record_failure("CodeCache is full");
      return;
    }
  %}
  ins_pipe(pipe_class_memory);
%}

instruct array_equalsC(iRegPNoSp ary1, iRegPNoSp ary2, iRegINoSp result,
                       iRegPNoSp tmp1, iRegPNoSp tmp2, iRegPNoSp tmp3,
                       vRegD vtmp0, vRegD vtmp1, vRegD vtmp2, vRegD vtmp3,
                       vRegD vtmp4, vRegD vtmp5, vRegD vtmp6, vRegD vtmp7,
                       iRegPNoSp tmp, rFlagsReg cr)
%{
  predicate(((AryEqNode*)n)->encoding() == StrIntrinsicNode::UU);
  match(Set result (AryEq ary1 ary2));
  effect(TEMP_DEF result, TEMP tmp, USE_KILL ary1, USE_KILL ary2, TEMP tmp1, TEMP tmp2, TEMP tmp3,
         TEMP vtmp0, TEMP vtmp1, TEMP vtmp2, TEMP vtmp3, TEMP vtmp4, TEMP vtmp5,
         TEMP vtmp6, TEMP vtmp7, KILL cr);

  format %{ "Array Equals $ary1,ary2 -> $result # KILL $ary1 $ary2 $tmp $tmp1 $tmp2 $tmp3 V0-V7 cr" %}
  ins_encode %{
    address tpc = __ arrays_equals($ary1$$Register, $ary2$$Register,
                                   $tmp1$$Register, $tmp2$$Register, $tmp3$$Register,
                                   $result$$Register, $tmp$$Register, 2);
    if (tpc == nullptr) {
      ciEnv::current()->record_failure("CodeCache is full");
      return;
    }
  %}
  ins_pipe(pipe_class_memory);
%}

// fast char[] to byte[] compression
instruct string_compress(iRegPNoSp src, iRegPNoSp dst, iRegINoSp len,
                         vRegD vtmp0, vRegD vtmp1, vRegD vtmp2,
                         vRegD vtmp3, vRegD vtmp4, vRegD vtmp5,
                         iRegINoSp result, rFlagsReg cr)
%{
  match(Set result (StrCompressedCopy src (Binary dst len)));
  effect(TEMP_DEF result, TEMP vtmp0, TEMP vtmp1, TEMP vtmp2, TEMP vtmp3, TEMP vtmp4, TEMP vtmp5,
         USE_KILL src, USE_KILL dst, USE len, KILL cr);

  format %{ "String Compress $src,$dst,$len -> $result # KILL $src $dst V0-V5 cr" %}
  ins_encode %{
    __ char_array_compress($src$$Register, $dst$$Register, $len$$Register,
                           $result$$Register, $vtmp0$$FloatRegister, $vtmp1$$FloatRegister,
                           $vtmp2$$FloatRegister, $vtmp3$$FloatRegister,
                           $vtmp4$$FloatRegister, $vtmp5$$FloatRegister);
  %}
  ins_pipe(pipe_slow);
%}

