// Intrisics for String.compareTo()

instruct string_compareU(iRegPNoSp str1, iRegINoSp cnt1, iRegPNoSp str2, iRegINoSp cnt2,
                        iRegINoSp result, iRegPNoSp tmp1, iRegLNoSp tmp2, rFlagsReg cr)
%{
  predicate((UseSVE == 0) && (((StrCompNode*)n)->encoding() == StrIntrinsicNode::UU));
  match(Set result (StrComp (Binary str1 cnt1) (Binary str2 cnt2)));
  effect(TEMP tmp1, TEMP tmp2, USE_KILL str1, USE_KILL str2, USE_KILL cnt1, USE_KILL cnt2, KILL cr);

  format %{ "String Compare $str1,$cnt1,$str2,$cnt2 -> $result   # KILL $tmp1" %}
  ins_encode %{
    // Count is in 8-bit bytes; non-Compact chars are 16 bits.
    __ string_compare($str1$$Register, $str2$$Register,
                      $cnt1$$Register, $cnt2$$Register, $result$$Register,
                      $tmp1$$Register, $tmp2$$Register,
                      fnoreg, fnoreg, fnoreg, pnoreg, pnoreg, StrIntrinsicNode::UU);
  %}
  ins_pipe(pipe_class_memory);
%}

instruct string_compareL(iRegPNoSp str1, iRegINoSp cnt1, iRegPNoSp str2, iRegINoSp cnt2,
                        iRegINoSp result, iRegPNoSp tmp1, iRegLNoSp tmp2, rFlagsReg cr)
%{
  predicate((UseSVE == 0) && (((StrCompNode*)n)->encoding() == StrIntrinsicNode::LL));
  match(Set result (StrComp (Binary str1 cnt1) (Binary str2 cnt2)));
  effect(TEMP tmp1, TEMP tmp2, USE_KILL str1, USE_KILL str2, USE_KILL cnt1, USE_KILL cnt2, KILL cr);

  format %{ "String Compare $str1,$cnt1,$str2,$cnt2 -> $result   # KILL $tmp1" %}
  ins_encode %{
    __ string_compare($str1$$Register, $str2$$Register,
                      $cnt1$$Register, $cnt2$$Register, $result$$Register,
                      $tmp1$$Register, $tmp2$$Register,
                      fnoreg, fnoreg, fnoreg, pnoreg, pnoreg, StrIntrinsicNode::LL);
  %}
  ins_pipe(pipe_class_memory);
%}

instruct string_compareUL(iRegPNoSp str1, iRegINoSp cnt1, iRegPNoSp str2, iRegINoSp cnt2,
                        iRegINoSp result, iRegPNoSp tmp1, iRegLNoSp tmp2,
                        vRegD vtmp1, vRegD vtmp2, vRegD vtmp3, rFlagsReg cr)
